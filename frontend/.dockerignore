# The build context is this directory, so what is not excluded is uploaded.
# node_modules alone is 698 MB and is reinstalled from the lockfile anyway.
node_modules
.next
coverage
test-results
playwright-report
*.tsbuildinfo

# Test-only inputs, excluded together. `next build` type-checks whatever the
# tsconfig includes, so leaving the specs behind while dropping the setup file
# that augments the matchers fails the build rather than trimming it.
e2e
playwright.config.ts
vitest.config.mts
vitest.setup.ts
**/*.test.ts
**/*.test.tsx

.env
.env.*
!.env.example
