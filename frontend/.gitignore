# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# generated route types
/.next/types

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Regenerated by next dev and next build. Repository conventions live in
# the root AGENTS.md, and a second instruction file here would compete with
# it, so it is ignored rather than deleted each time.
/AGENTS.md
/CLAUDE.md
