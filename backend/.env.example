SKILLSYNC_APP_NAME=SkillSync API
SKILLSYNC_ENVIRONMENT=local
SKILLSYNC_DEBUG=false
SKILLSYNC_DATABASE_URL=postgresql+psycopg://localhost/skillsync
SKILLSYNC_CV_MAX_UPLOAD_BYTES=5242880
SKILLSYNC_CV_ALLOWED_FORMATS=["pdf"]
SKILLSYNC_CV_STORAGE_ROOT=uploads/cvs
SKILLSYNC_CV_PDF_MAX_PAGES=20
SKILLSYNC_CV_PDF_MAX_TEXT_CHARACTERS=100000
SKILLSYNC_CV_PDF_TIMEOUT_SECONDS=5
