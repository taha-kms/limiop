POSTGRES_DB=skillsync
POSTGRES_USER=skillsync
POSTGRES_PASSWORD=replace-me
SKILLSYNC_DATABASE_URL=postgresql+psycopg://skillsync:replace-me@database:5432/skillsync
SKILLSYNC_API_PORT=8000
POSTGRES_PORT=5432
AIRFLOW_API_PORT=8080
AIRFLOW_METADATA_DATABASE=airflow

# Where the browser reaches the API. Public, not a secret: the job
# catalogue is readable without an account.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Where the server reaches the API. Set this when the two differ, such as
# inside Compose where the server uses the service name.
SKILLSYNC_API_URL=http://api:8000
SKILLSYNC_FRONTEND_PORT=3000
